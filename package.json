{
  "name": "patche",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.4.3",
      "typescript": "^7.0.2",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "stripe": "^22.6.1",
      "tailwindcss": "^4.3.3",
      "@libsql/client": "0.17.4",
      "libsql": "0.5.29",
      "better-auth": "1.7.1",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "APP_ENV=development varlock run -- turbo run dev -F @patche/infra",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test:e2e": "turbo run test:e2e -F web",
    "test:integration": "bun run --cwd apps/web test:integration",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:studio": "turbo run db:studio -F @patche/db --",
    "deploy": "STAGE=production varlock run -- turbo run deploy -F @patche/infra -- --stage production",
    "destroy": "varlock run -- turbo run destroy -F @patche/infra --",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@patche/env": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@patche/config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@varlock/1password-plugin": "^2.0.4",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "lefthook": "^2.1.12",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.81.0",
    "oxlint-plugin-react-doctor": "^0.9.13",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0",
    "varlock": "^1.20.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "hono": "4.13.7",
    "lodash": "4.18.0",
    "srvx": "0.12.0",
    "valibot": "1.4.2",
    "workerd": "1.20260901.1"
  },
  "packageManager": "bun@1.4.0"
}
