{
  "name": "patche",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^7.0.2",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@libsql/client": "0.17.4",
      "libsql": "0.5.29",
      "better-auth": "1.7.1",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:generate": "turbo run db:generate -F @patche/db --",
    "deploy": "turbo run deploy -F @patche/infra --",
    "destroy": "turbo run destroy -F @patche/infra --",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@patche/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@patche/config": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "lefthook": "^2.1.12",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-plugin-react-doctor": "^0.9.13",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0"
  },
  "packageManager": "bun@1.4.0"
}
