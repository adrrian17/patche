# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN)
# ---

# Worker secrets that Varlock resolves before `alchemy dev` and `alchemy deploy`.
# Defaults to production; local scripts opt into development or e2e, and PR previews use preview.
# development and e2e run on local D1, R2, and the Alchemy email simulator, so they use the placeholders below and never open 1Password.
# The one real local secret is a Stripe test-mode STRIPE_SECRET_KEY in a git-ignored .env.local (or .env.e2e.local / .env.development.local).
# With OP_SERVICE_ACCOUNT_TOKEN set (CI), e2e reads it from op://Patche/E2E instead.
# @type=enum(development, e2e, preview, production)
APP_ENV=production

# 1Password service account token for non-interactive runs.
# @type=opServiceAccountToken @sensitive @optional @internal
OP_SERVICE_ACCOUNT_TOKEN=

# Cloudflare credentials for `alchemy deploy` in CI. Local deploys keep using `alchemy profile`.
# `alchemy dev` insists on them but never calls the API for local resources.
# @sensitive @optional
CLOUDFLARE_API_TOKEN=ifs(eq($APP_ENV, production), op(op://Patche/Production/CLOUDFLARE_API_TOKEN, allowMissing=true), eq($APP_ENV, preview), op(op://Patche/Development/CLOUDFLARE_API_TOKEN, allowMissing=true), local-placeholder)

# @sensitive
CLOUDFLARE_ACCOUNT_ID=ifs(eq($APP_ENV, production), op(op://Patche/Production/CLOUDFLARE_ACCOUNT_ID), eq($APP_ENV, preview), op(op://Patche/Development/CLOUDFLARE_ACCOUNT_ID), "00000000000000000000000000000000")

# Cloudflare account ID used by the S3-compatible R2 API.
# @required=forEnv(production)
CF_ACCOUNT_ID=if(eq($APP_ENV, production), op(op://Patche/Production/CLOUDFLARE_ACCOUNT_ID))

# @sensitive @required
BETTER_AUTH_SECRET=ifs(eq($APP_ENV, production), op(op://Patche/Production/BETTER_AUTH_SECRET), eq($APP_ENV, preview), op(op://Patche/Development/BETTER_AUTH_SECRET), local-placeholder-better-auth-secret-000000)

# @sensitive @required
R2_ACCESS_KEY_ID=ifs(eq($APP_ENV, production), op(op://Patche/Production/R2_ACCESS_KEY_ID), eq($APP_ENV, preview), op(op://Patche/Development/R2_ACCESS_KEY_ID), local-placeholder-r2-access-key-id)

# @sensitive @required
R2_SECRET_ACCESS_KEY=ifs(eq($APP_ENV, production), op(op://Patche/Production/R2_SECRET_ACCESS_KEY), eq($APP_ENV, preview), op(op://Patche/Development/R2_SECRET_ACCESS_KEY), local-placeholder-r2-secret-access-key)

# @sensitive @required
STRIPE_SECRET_KEY=ifs(eq($APP_ENV, production), op(op://Patche/Production/STRIPE_SECRET_KEY), eq($APP_ENV, preview), op(op://Patche/Development/STRIPE_SECRET_KEY), eq($APP_ENV, e2e), if(not(isEmpty($OP_SERVICE_ACCOUNT_TOKEN)), op(op://Patche/E2E/STRIPE_SECRET_KEY)))

# Locally the E2E helpers sign webhook events with the same value the Worker verifies, so a placeholder works.
# @sensitive @required
STRIPE_WEBHOOK_SECRET=ifs(eq($APP_ENV, production), op(op://Patche/Production/STRIPE_WEBHOOK_SECRET), eq($APP_ENV, preview), op(op://Patche/Development/STRIPE_WEBHOOK_SECRET), whsec_local_placeholder)
