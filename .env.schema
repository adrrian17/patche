# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=forEnv(development))
# ---

# Worker environment used by Varlock and the deployment wrapper.
# @type=enum(development, production)
APP_ENV=development

# 1Password service account token. Set as a secret in Cloudflare Builds.
# @type=opServiceAccountToken @sensitive @optional @internal
OP_SERVICE_ACCOUNT_TOKEN=

# Cloudflare account ID used by the S3-compatible R2 API.
# Set as a non-secret Cloudflare Build variable and in your local environment.
# @required=forEnv(production)
CLOUDFLARE_ACCOUNT_ID=if(eq($APP_ENV, production), op(op://Patche/Production/CLOUDFLARE_ACCOUNT_ID))

# Set in Cloudflare Builds to the Worker URL, e.g. https://patche-web.<subdomain>.workers.dev.
# @public @required=forEnv(production) @type=url
WORKER_PUBLIC_URL=if(eq($APP_ENV, production), op(op://Patche/Production/WORKER_PUBLIC_URL), http://localhost:3001)

BETTER_AUTH_URL=if(eq($APP_ENV, production), $WORKER_PUBLIC_URL, http://localhost:3001)
MEDIA_PUBLIC_BASE_URL=$BETTER_AUTH_URL
MEDIA_PUBLIC_PROXY=true
DIGITAL_BUCKET_NAME=patche-digital

# @sensitive @required
BETTER_AUTH_SECRET=if(eq($APP_ENV, production), op(op://Patche/Production/BETTER_AUTH_SECRET), op(op://Patche/Development/BETTER_AUTH_SECRET))

# @sensitive @required
R2_ACCESS_KEY_ID=if(eq($APP_ENV, production), op(op://Patche/Production/R2_ACCESS_KEY_ID), op(op://Patche/Development/R2_ACCESS_KEY_ID))

# @sensitive @required
R2_SECRET_ACCESS_KEY=if(eq($APP_ENV, production), op(op://Patche/Production/R2_SECRET_ACCESS_KEY), op(op://Patche/Development/R2_SECRET_ACCESS_KEY))

# @sensitive @required
STRIPE_SECRET_KEY=if(eq($APP_ENV, production), op(op://Patche/Production/STRIPE_SECRET_KEY), op(op://Patche/Development/STRIPE_SECRET_KEY))

# @sensitive @required
STRIPE_WEBHOOK_SECRET=if(eq($APP_ENV, production), op(op://Patche/Production/STRIPE_WEBHOOK_SECRET), op(op://Patche/Development/STRIPE_WEBHOOK_SECRET))
