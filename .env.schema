# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=forEnv(development, e2e))
# ---

# Worker secrets that Varlock resolves before `alchemy dev` and `alchemy deploy`.
# Defaults to production; local scripts opt into development explicitly.
# e2e reads the Development items for now; swap it to op://Patche/E2E/* once the Stripe E2E sandbox exists.
# @type=enum(development, e2e, production)
APP_ENV=production

# 1Password service account token for non-interactive runs.
# @type=opServiceAccountToken @sensitive @optional @internal
OP_SERVICE_ACCOUNT_TOKEN=

# Cloudflare credentials for `alchemy deploy` in CI. Local deploys keep using `alchemy profile`.
# @sensitive @optional
CLOUDFLARE_API_TOKEN=if(eq($APP_ENV, production), op(op://Patche/Production/CLOUDFLARE_API_TOKEN, allowMissing=true), op(op://Patche/Development/CLOUDFLARE_API_TOKEN, allowMissing=true))

# @sensitive
CLOUDFLARE_ACCOUNT_ID=if(eq($APP_ENV, production), op(op://Patche/Production/CLOUDFLARE_ACCOUNT_ID), op(op://Patche/Development/CLOUDFLARE_ACCOUNT_ID))

# Cloudflare account ID used by the S3-compatible R2 API.
# @required=forEnv(production)
CF_ACCOUNT_ID=if(eq($APP_ENV, production), op(op://Patche/Production/CLOUDFLARE_ACCOUNT_ID))

# @sensitive @required
BETTER_AUTH_SECRET=if(eq($APP_ENV, production), op(op://Patche/Production/BETTER_AUTH_SECRET), op(op://Patche/Development/BETTER_AUTH_SECRET))

# @sensitive @required
R2_ACCESS_KEY_ID=if(eq($APP_ENV, production), op(op://Patche/Production/R2_ACCESS_KEY_ID), op(op://Patche/Development/R2_ACCESS_KEY_ID))

# @sensitive @required
R2_SECRET_ACCESS_KEY=if(eq($APP_ENV, production), op(op://Patche/Production/R2_SECRET_ACCESS_KEY), op(op://Patche/Development/R2_SECRET_ACCESS_KEY))

# @sensitive @required
STRIPE_SECRET_KEY=if(eq($APP_ENV, production), op(op://Patche/Production/STRIPE_SECRET_KEY), op(op://Patche/Development/STRIPE_SECRET_KEY))

# @sensitive @required
STRIPE_WEBHOOK_SECRET=if(eq($APP_ENV, production), op(op://Patche/Production/STRIPE_WEBHOOK_SECRET), op(op://Patche/Development/STRIPE_WEBHOOK_SECRET))
