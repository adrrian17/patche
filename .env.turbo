# Turborepo remote cache credentials, resolved by `varlock run --path .env.turbo` for build, check-types, and test.
# Kept apart from .env.schema so cached tasks never resolve app secrets.
# CI without a 1Password token (fork PRs) skips resolution and runs with a local cache only.
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=not($CI))
# @defaultRequired=false @defaultSensitive=true
# ---

# 1Password service account token for non-interactive runs.
# @type=opServiceAccountToken @internal
OP_SERVICE_ACCOUNT_TOKEN=

# Set by CI providers. Left empty locally so nothing injects CI=false into child processes.
# @type=boolean @sensitive=false
CI=

# @type=boolean @sensitive=false @internal
HAS_1PASSWORD=if($CI, not(isEmpty($OP_SERVICE_ACCOUNT_TOKEN)), true)

# @sensitive=false
TURBO_API=if($HAS_1PASSWORD, op(op://Patche/Turborepo/TURBO_API))
# @sensitive=false
TURBO_TEAM=if($HAS_1PASSWORD, op(op://Patche/Turborepo/TURBO_TEAM))
TURBO_TOKEN=if($HAS_1PASSWORD, op(op://Patche/Turborepo/TURBO_TOKEN))
TURBO_REMOTE_CACHE_SIGNATURE_KEY=if($HAS_1PASSWORD, op(op://Patche/Turborepo/TURBO_REMOTE_CACHE_SIGNATURE_KEY))
